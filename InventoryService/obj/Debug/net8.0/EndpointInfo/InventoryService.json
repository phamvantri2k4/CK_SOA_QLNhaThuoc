{
  "openapi": "3.0.4",
  "info": {
    "title": "InventoryService",
    "version": "1.0"
  },
  "paths": {
    "/api/inventory/import": {
      "post": {
        "tags": [
          "Inventory"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportStockRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportStockRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ImportStockRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/inventory/export": {
      "post": {
        "tags": [
          "Inventory"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportStockRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportStockRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ExportStockRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/inventory/status": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/inventory/expiry-warning": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "InventoryService"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExportStockRequest": {
        "type": "object",
        "properties": {
          "drugId": {
            "type": "integer",
            "format": "int32"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "unitType": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ImportStockRequest": {
        "type": "object",
        "properties": {
          "drugId": {
            "type": "integer",
            "format": "int32"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "unitType": {
            "type": "string",
            "nullable": true
          },
          "expiryDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}