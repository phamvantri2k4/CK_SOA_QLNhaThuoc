@model PharmaWebApp.Models.PagedList<PharmaWebApp.Models.DrugViewModel>
@{
    ViewData["Title"] = "Danh sách Thuốc";
    
    // Helper function for Vietnamese number formatting
    string FormatVND(decimal amount)
    {
        return amount.ToString("N0", new System.Globalization.CultureInfo("vi-VN"));
    }
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Danh sách Thuốc</h2>
            <p class="text-muted mb-0">Dữ liệu được lấy từ DrugService API</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus"></i> Thêm thuốc
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            <strong>Lỗi:</strong> @ViewBag.ErrorMessage
        </div>
    }

    @if (Model != null && Model.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Ảnh</th>
                        <th>Thông tin thuốc</th>
                        <th>Số lượng</th>
                        <th>Giá nhập</th>
                        <th>Giá bán</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var drug in Model.Items)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(drug.ImageUrl))
                                {
                                    <img src="@drug.ImageUrl" alt="@drug.Name" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;" />
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; border-radius: 8px;">
                                        <i class="bi bi-image text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <div>
                                    <strong>@drug.Name</strong>
                                    <br />
                                    <small class="text-muted">@drug.Code</small>
                                    <br />
                                    <span class="badge bg-secondary">@drug.Category</span>
                                </div>
                            </td>
                            <td>
                                <div>
                                    <strong>@drug.PackSize</strong> @drug.Unit.ToLower()/hộp
                                    <br />
                                    <small class="text-muted">Đơn vị: @drug.Unit</small>
                                </div>
                            </td>
                            <td>
                                <div>
                                    <strong>@FormatVND(drug.ImportPrice)</strong> VNĐ
                                    <br />
                                    <small class="text-muted">Giá nhập/hộp</small>
                                </div>
                            </td>
                            <td>
                                <div>
                                    @if (drug.SellPricePerPill > 0)
                                    {
                                        <div class="text-success">
                                            <strong>@FormatVND(drug.SellPricePerPill)</strong> VNĐ
                                            <br />
                                            <small class="text-muted">Giá viên</small>
                                        </div>
                                    }
                                    @if (drug.BoxPrice > 0)
                                    {
                                        <div class="text-primary mt-1">
                                            <strong>@FormatVND(drug.BoxPrice)</strong> VNĐ
                                            <br />
                                            <small class="text-muted">Giá hộp</small>
                                        </div>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="btn-group-vertical gap-1" role="group">
                                    <a asp-action="Details" asp-route-id="@drug.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> Chi tiết
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@drug.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@drug.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @* Phân trang *@
        @await Html.PartialAsync("_Pagination", Model)
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-capsule text-muted" style="font-size: 3rem;"></i>
            <h4 class="mt-3 text-muted">Chưa có thuốc nào</h4>
            <p class="text-muted">Bắt đầu bằng cách thêm thuốc mới vào hệ thống.</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus"></i> Thêm thuốc đầu tiên
            </a>
        </div>
    }
</div>

