@model PharmaWebApp.Models.DrugViewModel
@{
    ViewData["Title"] = "Chi tiết thuốc";
    
    var hasSellPricePerPill = Model != null && Model.SellPricePerPill > 0;
    var hasBoxPrice = Model != null && Model.BoxPrice > 0;
    var packSize = Model?.PackSize ?? 0;
    var hasPackSize = packSize > 0;
    
    // Helper function for Vietnamese number formatting
    string FormatVND(int amount)
    {
        return amount.ToString("N0", new System.Globalization.CultureInfo("vi-VN"));
    }
}

<div class="container py-4">
    <h2>Chi tiết Thuốc</h2>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            <strong>Lỗi:</strong> @ViewBag.ErrorMessage
        </div>
    }

    @if (Model != null)
    {
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">@Model.Name</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 text-center">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded" style="max-width: 200px;" />
                        }
                        else
                        {
                            <div class="bg-light p-5 rounded">
                                <p class="text-muted">Không có ảnh</p>
                            </div>
                        }
                    </div>
                    <div class="col-md-4">
                        <table class="table">
                            <tr>
                                <th width="150">ID:</th>
                                <td>@Model.Id</td>
                            </tr>
                            <tr>
                                <th>Mã thuốc:</th>
                                <td><code>@Model.Code</code></td>
                            </tr>
                            <tr>
                                <th>Tên thuốc:</th>
                                <td><strong>@Model.Name</strong></td>
                            </tr>
                            <tr>
                                <th>Danh mục:</th>
                                <td>@Model.Category</td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-4">
                        <table class="table">
                            <tr>
                                <th width="150">Đơn vị:</th>
                                <td>@Model.Unit</td>
                            </tr>
                            <tr>
                                <th>Số viên trong mỗi hộp:</th>
                                <td>
                                    <div><strong>@Model.PackSize</strong> <span class="text-muted">viên / hộp</span></div>
                                    <div class="small text-muted">Mỗi hộp chứa @Model.PackSize viên thuốc</div>
                                </td>
                            </tr>
                            <tr>
                                <th>Giá nhập:</th>
                                <td>
                                    <div><strong>@FormatVND(Model.ImportPrice) VNĐ</strong> <span class="text-muted">/ 1 hộp</span></div>
                                </td>
                            </tr>
                            <tr>
                                <th>Giá bán lẻ theo viên:</th>
                                <td>
                                    @if (hasSellPricePerPill)
                                    {
                                        <div><strong class="text-success">@FormatVND(Model.SellPricePerPill) VNĐ</strong> <span class="text-muted">/ 1 viên</span></div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Không có giá bán lẻ theo viên</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>Giá bán hộp:</th>
                                <td>
                                    @if (hasBoxPrice)
                                    {
                                        <div><strong class="text-success">@FormatVND(Model.BoxPrice) VNĐ</strong> <span class="text-muted">/ 1 hộp (@Model.PackSize @Model.Unit)</span></div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Không bán theo hộp</span>
                                    }
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <a asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-house"></i> Về trang chủ
                </a>
            </div>
        </div>
    }
</div>

