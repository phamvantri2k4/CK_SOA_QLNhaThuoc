@model PharmaWebApp.Models.DrugViewModel
@{
    ViewData["Title"] = "Chi tiết Thuốc";
    var hasPillPrice = Model != null && Model.SellPrice > 0;
    var hasBoxPrice = Model != null && Model.BoxPrice > 0;
    var packSize = Model?.PackSize ?? 0;
    var hasPackSize = packSize > 0;
}

<div class="container py-4">
    <h2>Chi tiết Thuốc</h2>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            <strong>Lỗi:</strong> @ViewBag.ErrorMessage
        </div>
    }

    @if (Model != null)
    {
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">@Model.Name</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 text-center">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded" style="max-width: 200px;" />
                        }
                        else
                        {
                            <div class="bg-light p-5 rounded">
                                <p class="text-muted">Không có ảnh</p>
                            </div>
                        }
                    </div>
                    <div class="col-md-4">
                        <table class="table">
                            <tr>
                                <th width="150">ID:</th>
                                <td>@Model.Id</td>
                            </tr>
                            <tr>
                                <th>Mã thuốc:</th>
                                <td><code>@Model.Code</code></td>
                            </tr>
                            <tr>
                                <th>Tên thuốc:</th>
                                <td><strong>@Model.Name</strong></td>
                            </tr>
                            <tr>
                                <th>Danh mục:</th>
                                <td>@Model.Category</td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-4">
                        <table class="table">
                            <tr>
                                <th width="150">Đơn vị:</th>
                                <td>@Model.Unit</td>
                            </tr>
                            <tr>
                                <th>Số viên / hộp:</th>
                                <td>@Model.PackSize</td>
                            </tr>
                            <tr>
                                <th>Giá nhập:</th>
                                <td>
                                    <div><strong>@Model.ImportPrice.ToString("N0") VNĐ</strong> <span class="text-muted">/ 1 hộp</span></div>
                                    @if (hasPackSize)
                                    {
                                        <div class="small text-muted">~ @((Model.ImportPrice / packSize).ToString("N0")) VNĐ / 1 @Model.Unit</div>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>Giá bán lẻ (1 @Model.Unit):</th>
                                <td>
                                    @if (hasPillPrice)
                                    {
                                        <strong class="text-success">@Model.SellPrice.ToString("N0") VNĐ</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Không bán lẻ</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>Giá bán hộp (1 hộp):</th>
                                <td>
                                    @if (hasBoxPrice)
                                    {
                                        <strong class="text-success">@Model.BoxPrice.ToString("N0") VNĐ</strong>
                                        @if (packSize > 0)
                                        {
                                            <div class="small text-muted">~ @((Model.BoxPrice / packSize).ToString("N0")) VNĐ / 1 @Model.Unit</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Không bán theo hộp</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>Lợi nhuận:</th>
                                <td>
                                    @if (hasPillPrice)
                                    {
                                        if (hasPackSize)
                                        {
                                            <div><strong class="text-info">@((Model.SellPrice - (Model.ImportPrice / packSize)).ToString("N0")) VNĐ</strong> <span class="text-muted">/ 1 @Model.Unit</span></div>
                                        }
                                        else
                                        {
                                            <div class="text-muted">Chưa có PackSize để tính lợi nhuận theo đơn vị</div>
                                        }
                                    }
                                    @if (hasBoxPrice)
                                    {
                                        <div><strong class="text-info">@((Model.BoxPrice - Model.ImportPrice).ToString("N0")) VNĐ</strong> <span class="text-muted">/ 1 hộp</span></div>
                                    }
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <a asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-house"></i> Về trang chủ
                </a>
            </div>
        </div>
    }
</div>

