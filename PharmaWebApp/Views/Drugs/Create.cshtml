@model PharmaWebApp.Models.CreateDrugViewModel
@{
    ViewData["Title"] = "Thêm thuốc mới";
    var categories = ViewBag.Categories as List<PharmaWebApp.Models.CategoryViewModel> ?? new List<PharmaWebApp.Models.CategoryViewModel>();
}

<div class="container py-4">
    <h2>Thêm thuốc mới</h2>
    <p class="text-muted">Nhập thông tin thuốc để thêm vào hệ thống</p>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <strong>Có lỗi xảy ra!</strong>
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Tên thuốc <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="Ví dụ: Paracetamol" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Code" class="form-label">Mã thuốc <span class="text-danger">*</span></label>
                    <input asp-for="Code" class="form-control" placeholder="Ví dụ: P001" required />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label asp-for="Category" class="form-label mb-0">Danh mục</label>
                        <a href="/Categories/Create" target="_blank" class="btn btn-sm btn-outline-success" 
                           onclick="window.categoryWindow = window.open(this.href, '_blank'); return false;">
                            <i class="bi bi-plus-circle"></i> Thêm danh mục mới
                        </a>
                    </div>
                    <select asp-for="Category" class="form-select" id="categorySelect">
                        <option value="">-- Chọn danh mục --</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Name">@c.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                    <small class="text-muted">
                        <i class="bi bi-info-circle"></i> 
                        Sau khi thêm danh mục mới, click vào dropdown để làm mới danh sách
                    </small>
                </div>

                <div class="mb-3">
                    <label asp-for="Unit" class="form-label">Đơn vị tính</label>
                    <select asp-for="Unit" class="form-select">
                        <option value="">-- Chọn đơn vị --</option>
                        <option value="Viên">Viên</option>
                        <option value="Vỉ">Vỉ</option>
                        <option value="Tuýp">Tuýp</option>
                        <option value="Chai">Chai</option>
                        <option value="Hộp">Hộp</option>
                        <option value="Gói">Gói</option>
                    </select>
                    <span asp-validation-for="Unit" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PackSize" class="form-label">Số viên trong mỗi hộp <span class="text-danger">*</span></label>
                    <input asp-for="PackSize" type="number" min="1" class="form-control" placeholder="Ví dụ: 10" required />
                    <span asp-validation-for="PackSize" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="ImportPrice" class="form-label">Giá nhập (VNĐ / 1 hộp) <span class="text-danger">*</span></label>
                    <input asp-for="ImportPrice" type="number" step="0" class="form-control" placeholder="0" required />
                    <span asp-validation-for="ImportPrice" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SellPricePerPill" class="form-label">Giá bán lẻ theo viên (VNĐ / 1 viên) <span class="text-danger">*</span></label>
                    <input asp-for="SellPricePerPill" type="number" step="0" class="form-control" placeholder="0" required />
                    <span asp-validation-for="SellPricePerPill" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BoxPrice" class="form-label">Giá bán hộp (VNĐ / 1 hộp)</label>
                    <input asp-for="BoxPrice" type="number" step="0" class="form-control" placeholder="0" />
                    <span asp-validation-for="BoxPrice" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageFile" class="form-label">Ảnh thuốc <span class="text-danger">*</span></label>
                    <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" required />
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Thêm thuốc
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // Open category creation in new tab and reload this page when closed
        let categoryWindow = null;
        const categoryLink = document.querySelector('a[href="/Categories/Create"]');
        
        if (categoryLink) {
            categoryLink.addEventListener('click', function(e) {
                e.preventDefault();
                categoryWindow = window.open(this.href, '_blank', 'width=800,height=600');
                
                // Check if window is closed
                const checkWindow = setInterval(function() {
                    if (categoryWindow && categoryWindow.closed) {
                        clearInterval(checkWindow);
                        // Reload page to get new categories
                        showToast('Đang tải lại danh mục...', 'info', 1000);
                        setTimeout(function() {
                            location.reload();
                        }, 500);
                    }
                }, 500);
            });
        }
    </script>
}
