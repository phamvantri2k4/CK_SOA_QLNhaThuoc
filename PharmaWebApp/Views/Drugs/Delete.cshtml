@model PharmaWebApp.Models.DrugViewModel
@{
    ViewData["Title"] = "Xóa thuốc";
}

<div class="container py-4">
    <h2>Xóa thuốc</h2>

    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa thuốc này? Hành động này không thể hoàn tác.
    </div>

    @if (Model != null)
    {
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">@Model.Name</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded" style="max-width: 100%;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px; border-radius: 4px;">
                                <span class="text-muted">Không có ảnh</span>
                            </div>
                        }
                    </div>
                    <div class="col-md-8">
                        <dl class="row">
                            <dt class="col-sm-4">Mã thuốc:</dt>
                            <dd class="col-sm-8"><code>@Model.Code</code></dd>

                            <dt class="col-sm-4">Tên thuốc:</dt>
                            <dd class="col-sm-8"><strong>@Model.Name</strong></dd>

                            <dt class="col-sm-4">Danh mục:</dt>
                            <dd class="col-sm-8">@Model.Category</dd>

                            <dt class="col-sm-4">Đơn vị:</dt>
                            <dd class="col-sm-8">@Model.Unit</dd>

                            <dt class="col-sm-4">Giá nhập:</dt>
                            <dd class="col-sm-8">@Model.ImportPrice.ToString("N0") VNĐ</dd>

                            <dt class="col-sm-4">Giá bán lẻ theo viên:</dt>
                            <dd class="col-sm-8"><strong class="text-success">@Model.SellPricePerPill.ToString("N0") VNĐ</strong></dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="mt-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger" onclick="return confirmDelete()">
                    <i class="bi bi-trash"></i> Xác nhận xóa
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-danger">
            Không tìm thấy thuốc.
        </div>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    }
</div>

<script>
    function confirmDelete() {
        showConfirm('Xác nhận xóa', 'Bạn có chắc chắn muốn xóa thuốc này? Hành động này không thể hoàn tác.', () => {
            document.querySelector('form').submit();
        });
        return false;
    }
</script>

