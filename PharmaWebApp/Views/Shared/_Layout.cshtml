<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pharmacity</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PharmaWebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar sticky-top">
            <div class="container-fluid app-container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-capsule-pill"></i>
                    <span>Pharmacity</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-grid"></i> Tổng quan
                                </a>
                            </li>

                            @if (User.IsInRole("Staff") || User.IsInRole("Owner"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Sales" asp-action="OrderCreate">
                                        <i class="bi bi-cart-plus"></i> Bán hàng
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Sales" asp-action="Index">
                                        <i class="bi bi-receipt"></i> Hóa đơn
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Owner"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-shield-lock"></i> Quản trị
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Inventory" asp-action="Index">
                                                <i class="bi bi-box-seam"></i> Kho
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Employees" asp-action="Index">
                                                <i class="bi bi-people"></i> Nhân viên
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Drugs" asp-action="Index">
                                                <i class="bi bi-capsule"></i> Thuốc
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Categories" asp-action="Index">
                                                <i class="bi bi-tags"></i> Danh mục thuốc
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Suppliers" asp-action="Index">
                                                <i class="bi bi-truck"></i> Nhà cung cấp
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Customers" asp-action="Index">
                                                <i class="bi bi-people"></i> Khách hàng
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">Báo cáo</h6></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Reports" asp-action="Day">Theo ngày</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Reports" asp-action="Month">Theo tháng</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Reports" asp-action="Year">Theo năm</a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i>
                                    <span>@User.FindFirst("FullName")?.Value</span>
                                    <span class="badge ms-1 @(User.IsInRole("Owner") ? "badge-role-owner" : "badge-role-staff")">
                                        @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person"></i> Thông tin tài khoản
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-container py-3">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white">
        <div class="container app-container">
            &copy; 2025 - Pharmacity - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_NotificationModal")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
