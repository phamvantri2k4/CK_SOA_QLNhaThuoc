@model PharmaWebApp.Models.AccountProfileViewModel
@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="py-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <div class="app-page-title"><i class="bi bi-person-circle"></i> Thông tin cá nhân</div>
            <div class="text-muted">Thông tin tài khoản đang đăng nhập</div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <strong>Hồ sơ</strong>
                </div>
                <div class="card-body">
                    <div class="mb-2"><strong>Họ tên:</strong> @Model.FullName</div>
                    <div class="mb-2"><strong>Tên đăng nhập:</strong> @Model.Username</div>
                    <div class="mb-2">
                        <strong>Vai trò:</strong>
                        <span class="badge ms-1 @(Model.Role == "Owner" ? "badge-role-owner" : "badge-role-staff")">@Model.Role</span>
                    </div>
                    <div class="mb-0">
                        <strong>Trạng thái:</strong>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Bị khóa</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <strong>Gợi ý</strong>
                </div>
                <div class="card-body">
                    <div class="text-muted">Nếu bạn cần đổi mật khẩu / cập nhật thông tin, hãy nhờ Admin thực hiện trong mục Quản lý nhân viên.</div>
                </div>
            </div>
        </div>
    </div>
</div>
