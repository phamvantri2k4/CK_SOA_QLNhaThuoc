@model List<Shared.ServiceInfo>
@{ 
    ViewData["Title"] = "Trang chủ - Pharmacity";
}

<div class="py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <div class="app-page-title">Tổng quan</div>
            <div class="text-muted">Chào mừng bạn đến Pharmacity (chạy local)</div>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Staff") || User.IsInRole("Owner"))
            {
                <a asp-controller="Sales" asp-action="OrderCreate" class="btn btn-success">
                    <i class="bi bi-cart-plus"></i> Bán hàng
                </a>
                <a asp-controller="Sales" asp-action="Index" class="btn btn-outline-success">
                    <i class="bi bi-receipt"></i> Hóa đơn
                </a>
            }
            @if (User.IsInRole("Owner"))
            {
                <a asp-controller="Suppliers" asp-action="CreateOrder" class="btn btn-outline-primary">
                    <i class="bi bi-truck"></i> Tạo đơn nhập
                </a>
            }
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <i class="bi bi-diagram-3"></i>
                        <span class="ms-1">Trạng thái Service Registry</span>
                    </div>
                    <span class="badge bg-light text-dark">Local</span>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="alert alert-success">
                            <strong>Service Registry đang hoạt động</strong>
                            <div class="text-muted">Đã tìm thấy @Model.Count service(s) đã đăng ký.</div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Tên Service</th>
                                        <th>URL</th>
                                        <th>Mô tả</th>
                                        <th>Version</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var service in Model)
                                    {
                                        <tr>
                                            <td><strong>@service.ServiceName</strong></td>
                                            <td><code>@service.Url</code></td>
                                            <td>@(service.Description ?? "-")</td>
                                            <td>@(service.Version ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            <strong>Không thể kết nối với Service Registry</strong>
                            <div class="text-muted">Hãy chạy ServiceRegistry trước (http://localhost:6000).</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-lightning-charge"></i>
                    <span class="ms-1">Lối tắt</span>
                </div>
                <div class="card-body d-grid gap-2">
                    @if (User.IsInRole("Staff") || User.IsInRole("Owner"))
                    {
                        <a asp-controller="Sales" asp-action="OrderCreate" class="btn btn-success">
                            <i class="bi bi-cart-plus"></i> Lập hóa đơn (POS)
                        </a>
                    }
                    @if (User.IsInRole("Owner"))
                    {
                        <a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-primary">
                            <i class="bi bi-box-seam"></i> Xem kho
                        </a>
                        <a asp-controller="Drugs" asp-action="Index" class="btn btn-outline-primary">
                            <i class="bi bi-capsule"></i> Quản lý thuốc
                        </a>
                        <a asp-controller="Suppliers" asp-action="Index" class="btn btn-outline-primary">
                            <i class="bi bi-truck"></i> Nhà cung cấp
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
