@model PharmaWebApp.Models.CreatePurchaseOrderViewModel
@{ 
    ViewData["Title"] = "Tạo đơn nhập";
    var suppliers = ViewBag.Suppliers as List<PharmaWebApp.Models.SupplierViewModel> ?? new();
    var drugs = ViewBag.Drugs as List<PharmaWebApp.Models.DrugViewModel> ?? new();
}

<div class="py-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <div class="app-page-title"><i class="bi bi-plus-circle"></i> Tạo đơn nhập</div>
            <div class="text-muted">Nhập hàng và cập nhật kho theo lô (số lượng, đơn giá, hạn dùng)</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" asp-controller="Drugs" asp-action="Create">
                <i class="bi bi-plus"></i> Thêm thuốc mới
            </a>
            <a class="btn btn-outline-secondary" asp-action="Orders"><i class="bi bi-arrow-left"></i> Quay lại</a>
        </div>
    </div>

    <form asp-action="CreateOrder" method="post">
        @Html.AntiForgeryToken()

        <div class="card mb-3">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Nhà cung cấp <span class="text-danger">*</span></label>
                    <select asp-for="SupplierId" class="form-select" required>
                        <option value="">-- Chọn nhà cung cấp --</option>
                        @foreach (var s in suppliers)
                        {
                            <option value="@s.Id">@s.Name (@s.Phone)</option>
                        }
                    </select>
                    <span asp-validation-for="SupplierId" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Chi tiết thuốc</strong>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow()">
                    <i class="bi bi-plus"></i> Thêm dòng
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="detailTable">
                        <thead>
                            <tr>
                                <th style="width:40%">Thuốc</th>
                                <th style="width:15%">Số lượng</th>
                                <th style="width:20%">Đơn giá</th>
                                <th style="width:20%">Hạn dùng</th>
                                <th style="width:5%"></th>
                            </tr>
                        </thead>
                        <tbody>
                    @for (int i = 0; i < Model.Details.Count; i++)
                    {
                        <tr>
                            <td>
                                <select name="Details[@i].DrugId" class="form-select" required onchange="onDrugChanged(this)">
                                    <option value="">-- Chọn thuốc --</option>
                                    @foreach (var d in drugs)
                                    {
                                        <option value="@d.Id">@d.Name</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input name="Details[@i].Quantity" type="number" min="1" class="form-control" value="1" required />
                            </td>
                            <td>
                                <input name="Details[@i].UnitPrice" type="number" step="0.01" min="0.01" class="form-control" value="0" required />
                            </td>
                            <td>
                                <input name="Details[@i].ExpiryDate" type="date" class="form-control" />
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)">
                                    <i class="bi bi-x"></i>
                                </button>
                            </td>
                        </tr>
                    }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer text-end">
                <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Tạo đơn</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function addRow() {
            const table = document.getElementById('detailTable').querySelector('tbody');
            const idx = table.querySelectorAll('tr').length;

            const drugs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(drugs.Select(d => new { id = d.Id, name = d.Name, importPrice = d.ImportPrice })));

            const drugOptions = ['<option value="">-- Chọn thuốc --</option>']
                .concat(drugs.map(d => `<option value="${d.id}">${d.name}</option>`))
                .join('');

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>
                    <select name="Details[${idx}].DrugId" class="form-select" required onchange="onDrugChanged(this)">
                        ${drugOptions}
                    </select>
                </td>
                <td>
                    <input name="Details[${idx}].Quantity" type="number" min="1" class="form-control" value="1" required />
                </td>
                <td>
                    <input name="Details[${idx}].UnitPrice" type="number" step="0.01" min="0.01" class="form-control" value="0" required />
                </td>
                <td>
                    <input name="Details[${idx}].ExpiryDate" type="date" class="form-control" />
                </td>
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)">
                        <i class="bi bi-x"></i>
                    </button>
                </td>
            `;
            table.appendChild(tr);
        }

        function onDrugChanged(selectEl) {
            const drugId = parseInt(selectEl.value || '0');
            if (!drugId) return;

            const allDrugs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                drugs.Select(d => new { id = d.Id, importPrice = d.ImportPrice })
            ));

            const selected = allDrugs.find(d => d.id === drugId);
            if (!selected) return;

            const row = selectEl.closest('tr');
            const unitPriceInput = row?.querySelector('input[name$=".UnitPrice"]');
            if (!unitPriceInput) return;

            const current = parseFloat(unitPriceInput.value || '0');
            if (current > 0) return;

            const suggested = parseFloat(selected.importPrice || 0);
            if (suggested > 0) {
                unitPriceInput.value = suggested;
            }
        }

        function removeRow(btn) {
            const tr = btn.closest('tr');
            const tbody = tr.parentElement;
            tr.remove();

            // re-index names to keep model binding clean
            const rows = tbody.querySelectorAll('tr');
            rows.forEach((row, idx) => {
                row.querySelectorAll('select, input').forEach(el => {
                    const name = el.getAttribute('name');
                    if (!name) return;
                    el.setAttribute('name', name.replace(/Details\[\d+\]/g, `Details[${idx}]`));
                });
            });
        }
    </script>
}
