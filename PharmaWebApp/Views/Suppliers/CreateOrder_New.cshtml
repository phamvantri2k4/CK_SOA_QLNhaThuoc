@model PharmaWebApp.Models.CreatePurchaseOrderViewModel
@{
    ViewData["Title"] = "Tạo đơn nhập";
    var suppliers = ViewBag.Suppliers as List<PharmaWebApp.Models.SupplierViewModel> ?? new();
    var drugs = ViewBag.Drugs as List<PharmaWebApp.Models.DrugViewModel> ?? new();
    var details = Model.Details ?? new List<PharmaWebApp.Models.CreatePurchaseOrderDetailViewModel>();
}

<div class="container-fluid py-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <div class="app-page-title"><i class="bi bi-plus-circle"></i> @ViewData["Title"]</div>
            <div class="text-muted">Chọn nhà cung cấp và thêm thuốc vào đơn nhập</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-action="Orders"><i class="bi bi-arrow-left"></i> Quay lại</a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@err.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="CreateOrder" method="post" id="createOrderForm">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header"><strong>Nhà cung cấp</strong></div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Chọn NCC <span class="text-danger">*</span></label>
                            <select class="form-select" name="SupplierId" required>
                                <option value="0">-- Chọn nhà cung cấp --</option>
                                @foreach (var s in suppliers)
                                {
                                    <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.Name</option>
                                }
                            </select>
                            <span asp-validation-for="SupplierId" class="text-danger"></span>
                        </div>

                        <div class="alert alert-info mb-0">
                            <div class="small">Gợi ý:</div>
                            <div class="small">- Thêm thuốc từ bảng bên phải</div>
                            <div class="small">- Nhập <strong>Số lượng</strong>, <strong>Đơn giá</strong></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Chi tiết thuốc nhập</strong>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="addRowBtn">
                            <i class="bi bi-plus"></i> Thêm dòng
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="detailsTable">
                                <thead>
                                    <tr>
                                        <th style="min-width: 240px;">Thuốc</th>
                                        <th class="text-center" style="width: 100px;">Số lượng</th>
                                        <th class="text-center" style="width: 90px;">Đơn vị</th>
                                        <th class="text-end" style="width: 140px;">Đơn giá</th>
                                        <th class="text-end" style="width: 120px;">Thành tiền</th>
                                        <th class="text-end" style="width: 80px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < details.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <select class="form-select form-select-sm" name="Details[@i].DrugId" required>
                                                    <option value="0">-- Chọn thuốc --</option>
                                                    @foreach (var d in drugs)
                                                    {
                                                        <option value="@d.Id" data-packsize="@d.PackSize" selected="@(details[i].DrugId == d.Id)">@d.Name (@d.Code)</option>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <input class="form-control form-control-sm text-center qty" type="number" min="1" name="Details[@i].Quantity" value="@details[i].Quantity" required />
                                            </td>
                                            <td>
                                                <select class="form-select form-select-sm unit-select" name="Details[@i].UnitType">
                                                    <option value="box">Hộp</option>
                                                    <option value="pill">Viên</option>
                                                </select>
                                            </td>
                                            <td>
                                                <input class="form-control form-control-sm text-end price" type="number" step="1" min="0" name="Details[@i].UnitPrice" value="@details[i].UnitPrice" required />
                                            </td>
                                            <td class="text-end fw-semibold line-total">0</td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-danger removeRowBtn"><i class="bi bi-x"></i></button>
                                            </td>
                                        </tr>
                                    }
                                    @if (details.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-3">Nhấn “Thêm dòng” để bắt đầu</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="4" class="text-end"><strong>TỔNG CỘNG:</strong></td>
                                        <td class="text-end"><strong class="text-success" id="grandTotal">0</strong></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <div class="card-footer d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary" asp-action="Orders">Hủy</a>
                        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Tạo đơn & cập nhật kho</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const drugs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                (drugs ?? new List<PharmaWebApp.Models.DrugViewModel>()).Select(d => new { id = d.Id, name = d.Name, code = d.Code, packSize = d.PackSize })
            ));

            const tbody = document.querySelector('#detailsTable tbody');
            const addRowBtn = document.getElementById('addRowBtn');
            const grandTotalEl = document.getElementById('grandTotal');

            function formatVND(n) {
                return (n || 0).toLocaleString('vi-VN') + ' ₫';
            }

            function recalc() {
                let total = 0;
                tbody.querySelectorAll('tr').forEach(tr => {
                    const qtyInput = tr.querySelector('.qty');
                    const priceInput = tr.querySelector('.price');
                    const totalEl = tr.querySelector('.line-total');
                    if (!qtyInput || !priceInput || !totalEl) return;
                    const qty = parseInt(qtyInput.value || '0', 10);
                    const price = parseInt((priceInput.value || '0').toString().replace(/[^\d]/g, ''), 10) || 0;
                    const line = (qty > 0 && price > 0) ? qty * price : 0;
                    totalEl.textContent = formatVND(line);
                    total += line;
                });
                grandTotalEl.textContent = formatVND(total);
            }

            function reindex() {
                const rows = Array.from(tbody.querySelectorAll('tr')).filter(r => r.querySelector('select'));
                rows.forEach((tr, i) => {
                    tr.querySelectorAll('select,input').forEach(el => {
                        const name = el.getAttribute('name');
                        if (!name) return;
                        el.setAttribute('name', name.replace(/Details\[\d+\]/g, `Details[${i}]`));
                    });
                });
            }

            function createRow(index) {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>
                        <select class="form-select form-select-sm" name="Details[${index}].DrugId" required>
                            <option value="0">-- Chọn thuốc --</option>
                            ${drugs.map(d => `<option value="${d.id}" data-packsize="${d.packSize || 1}">${d.name} (${d.code})</option>`).join('')}
                        </select>
                    </td>
                    <td>
                        <input class="form-control form-control-sm text-center qty" type="number" min="1" name="Details[${index}].Quantity" value="1" required />
                    </td>
                    <td>
                        <select class="form-select form-select-sm unit-select" name="Details[${index}].UnitType">
                            <option value="box">Hộp</option>
                            <option value="pill">Viên</option>
                        </select>
                    </td>
                    <td>
                        <input class="form-control form-control-sm text-end price" type="number" step="1" min="0" name="Details[${index}].UnitPrice" value="0" required />
                    </td>
                    <td class="text-end fw-semibold line-total">0</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-danger removeRowBtn"><i class="bi bi-x"></i></button>
                    </td>
                `;
               return tr;
            }

            function ensureEmptyRowMessageRemoved() {
                const msgRow = tbody.querySelector('tr td[colspan="6"]');
                if (msgRow) msgRow.closest('tr').remove();
            }

            addRowBtn.addEventListener('click', function () {
                ensureEmptyRowMessageRemoved();
                const currentRows = Array.from(tbody.querySelectorAll('tr')).filter(r => r.querySelector('select')).length;
                tbody.appendChild(createRow(currentRows));
                reindex();
                recalc();
            });

            tbody.addEventListener('input', function (e) {
                if (e.target.classList.contains('qty') || e.target.classList.contains('price')) {
                    recalc();
                }
            });

            tbody.addEventListener('click', function (e) {
                const btn = e.target.closest('.removeRowBtn');
                if (!btn) return;
                const tr = btn.closest('tr');
                tr.remove();
                reindex();
                recalc();

                const hasRows = Array.from(tbody.querySelectorAll('tr')).some(r => r.querySelector('select'));
                if (!hasRows) {
                    const empty = document.createElement('tr');
                    empty.innerHTML = `<td colspan="5" class="text-center text-muted py-3">Nhấn “Thêm dòng” để bắt đầu</td>`;
                    tbody.appendChild(empty);
                }
            });

            recalc();
        })();
    </script>
}
