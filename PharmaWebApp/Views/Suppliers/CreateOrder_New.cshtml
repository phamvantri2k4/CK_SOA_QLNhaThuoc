@model PharmaWebApp.Models.CreatePurchaseOrderViewModel
@{
    ViewData["Title"] = "Tạo đơn nhập";
    var suppliers = ViewBag.Suppliers as List<PharmaWebApp.Models.SupplierViewModel> ?? new();
    var drugs = ViewBag.Drugs as List<PharmaWebApp.Models.DrugViewModel> ?? new();
    var details = Model.Details ?? new List<PharmaWebApp.Models.CreatePurchaseOrderDetailViewModel>();
}

<style>
    .item-card {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 15px;
        border-left: 4px solid var(--app-primary);
        position: relative;
    }
    .item-card:hover {
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .remove-btn {
        position: absolute;
        top: 10px;
        right: 10px;
    }
    .input-group-text {
        background: white;
        border-left: none;
    }
    .form-control:focus + .input-group-text {
        border-color: #86b7fe;
    }
    .total-display {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--app-primary);
    }
</style>

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="app-page-title"><i class="bi bi-plus-circle"></i> @ViewData["Title"]</div>
            <div class="text-muted">Chọn nhà cung cấp và thêm thuốc vào đơn nhập</div>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Orders"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@err.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="CreateOrder" method="post" id="createOrderForm">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header"><strong>Nhà cung cấp</strong></div>
                    <div class="card-body">
                        <label class="form-label">Chọn NCC <span class="text-danger">*</span></label>
                        <select class="form-select" name="SupplierId" required>
                            <option value="0">-- Chọn nhà cung cấp --</option>
                            @foreach (var s in suppliers)
                            {
                                <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.Name</option>
                            }
                        </select>
                        <span asp-validation-for="SupplierId" class="text-danger"></span>

                        <div class="alert alert-info mt-3 mb-0">
                            <div class="small"><strong>Gợi ý:</strong></div>
                            <div class="small">• Thêm thuốc bằng nút "+ Thêm thuốc"</div>
                            <div class="small">• Nhập đầy đủ thông tin mỗi dòng</div>
                        </div>
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header"><strong>Tổng cộng</strong></div>
                    <div class="card-body text-center">
                        <div class="total-display" id="grandTotal">0 ₫</div>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a class="btn btn-outline-secondary flex-fill" asp-action="Orders">Hủy</a>
                        <button type="submit" class="btn btn-success flex-fill">
                            <i class="bi bi-check-circle"></i> Tạo đơn
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Chi tiết thuốc nhập</strong>
                        <button type="button" class="btn btn-sm btn-primary" id="addRowBtn">
                            <i class="bi bi-plus"></i> Thêm thuốc
                        </button>
                    </div>
                    <div class="card-body" id="itemsContainer">
                        @if (details.Count == 0)
                        {
                            <div class="text-center text-muted py-5" id="emptyMessage">
                                <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                                <div class="mt-2">Nhấn "Thêm thuốc" để bắt đầu</div>
                            </div>
                        }
                        else
                        {
                            @for (int i = 0; i < details.Count; i++)
                            {
                                <div class="item-card">
                                    <button type="button" class="btn btn-sm btn-danger remove-btn removeRowBtn">
                                        <i class="bi bi-x"></i>
                                    </button>

                                    <div class="row g-3">
                                        <div class="col-md-12">
                                            <label class="form-label">Thuốc <span class="text-danger">*</span></label>
                                            <select class="form-select" name="Details[@i].DrugId" required>
                                                <option value="0">-- Chọn thuốc --</option>
                                                @foreach (var d in drugs)
                                                {
                                                    <option value="@d.Id" data-packsize="@d.PackSize" selected="@(details[i].DrugId == d.Id)">
                                                        @d.Name (@d.Code)
                                                    </option>
                                                }
                                            </select>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Số lượng <span class="text-danger">*</span></label>
                                            <input class="form-control qty" type="number" min="1" name="Details[@i].Quantity" 
                                                   value="@details[i].Quantity" required />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Đơn vị</label>
                                            <select class="form-select unit-select" name="Details[@i].UnitType">
                                                <option value="box">Hộp</option>
                                                <option value="pill">Viên</option>
                                            </select>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Hạn sử dụng</label>
                                            <input class="form-control" type="date" name="Details[@i].ExpiryDate" 
                                                   value="@details[i].ExpiryDate?.ToString("yyyy-MM-dd")" />
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">Đơn giá <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <input class="form-control price" type="number" step="1" min="0" 
                                                       name="Details[@i].UnitPrice" value="@details[i].UnitPrice" required />
                                                <span class="input-group-text">₫</span>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">Thành tiền</label>
                                            <div class="input-group">
                                                <input class="form-control line-total" type="text" readonly style="background: #e9ecef;" value="0" />
                                                <span class="input-group-text">₫</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const drugs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                (drugs ?? new List<PharmaWebApp.Models.DrugViewModel>()).Select(d => new { id = d.Id, name = d.Name, code = d.Code, packSize = d.PackSize })
            ));

            const container = document.getElementById('itemsContainer');
            const addRowBtn = document.getElementById('addRowBtn');
            const grandTotalEl = document.getElementById('grandTotal');
            const emptyMsg = document.getElementById('emptyMessage');

            function formatVND(n) {
                return (n || 0).toLocaleString('vi-VN') + ' ₫';
            }

            function recalc() {
                let total = 0;
                container.querySelectorAll('.item-card').forEach(card => {
                    const qtyInput = card.querySelector('.qty');
                    const priceInput = card.querySelector('.price');
                    const totalInput = card.querySelector('.line-total');
                    if (!qtyInput || !priceInput || !totalInput) return;
                    
                    const qty = parseInt(qtyInput.value || '0', 10);
                    const price = parseInt((priceInput.value || '0').toString().replace(/[^\d]/g, ''), 10) || 0;
                    const line = (qty > 0 && price > 0) ? qty * price : 0;
                    totalInput.value = formatVND(line);
                    total += line;
                });
                grandTotalEl.textContent = formatVND(total);
            }

            function reindex() {
                const cards = Array.from(container.querySelectorAll('.item-card'));
                cards.forEach((card, i) => {
                    card.querySelectorAll('select,input').forEach(el => {
                        const name = el.getAttribute('name');
                        if (!name) return;
                        el.setAttribute('name', name.replace(/Details\[\d+\]/g, `Details[${i}]`));
                    });
                });
            }

            function createCard(index) {
                const card = document.createElement('div');
                card.className = 'item-card';
                card.innerHTML = `
                    <button type="button" class="btn btn-sm btn-danger remove-btn removeRowBtn">
                        <i class="bi bi-x"></i>
                    </button>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label">Thuốc <span class="text-danger">*</span></label>
                            <select class="form-select" name="Details[${index}].DrugId" required>
                                <option value="0">-- Chọn thuốc --</option>
                                ${drugs.map(d => `<option value="${d.id}" data-packsize="${d.packSize || 1}">${d.name} (${d.code})</option>`).join('')}
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Số lượng <span class="text-danger">*</span></label>
                            <input class="form-control qty" type="number" min="1" name="Details[${index}].Quantity" value="1" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Đơn vị</label>
                            <select class="form-select unit-select" name="Details[${index}].UnitType">
                                <option value="box">Hộp</option>
                                <option value="pill">Viên</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Hạn sử dụng</label>
                            <input class="form-control" type="date" name="Details[${index}].ExpiryDate" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Đơn giá <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input class="form-control price" type="number" step="1" min="0" name="Details[${index}].UnitPrice" value="0" required />
                                <span class="input-group-text">₫</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Thành tiền</label>
                            <div class="input-group">
                                <input class="form-control line-total" type="text" readonly style="background: #e9ecef;" value="0 ₫" />
                                <span class="input-group-text">₫</span>
                            </div>
                        </div>
                    </div>
                `;
                return card;
            }

            addRowBtn.addEventListener('click', function () {
                if (emptyMsg) emptyMsg.remove();
                const currentCards = container.querySelectorAll('.item-card').length;
                container.appendChild(createCard(currentCards));
                reindex();
                recalc();
            });

            container.addEventListener('input', function (e) {
                if (e.target.classList.contains('qty') || e.target.classList.contains('price')) {
                    recalc();
                }
            });

            container.addEventListener('click', function (e) {
                const btn = e.target.closest('.removeRowBtn');
                if (!btn) return;
                const card = btn.closest('.item-card');
                card.remove();
                reindex();
                recalc();

                const hasCards = container.querySelectorAll('.item-card').length > 0;
                if (!hasCards) {
                    const empty = document.createElement('div');
                    empty.id = 'emptyMessage';
                    empty.className = 'text-center text-muted py-5';
                    empty.innerHTML = `
                        <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                        <div class="mt-2">Nhấn "Thêm thuốc" để bắt đầu</div>
                    `;
                    container.appendChild(empty);
                }
            });

            recalc();
        })();
    </script>
}
