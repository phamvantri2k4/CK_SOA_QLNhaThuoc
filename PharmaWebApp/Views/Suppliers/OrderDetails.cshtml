@model PharmaWebApp.Models.PurchaseOrderDetailsResponseViewModel
@{
    ViewData["Title"] = "Chi tiết đơn nhập";
    var totalAmount = Model?.Details?.Sum(d => d.UnitPrice * d.Quantity) ?? 0m;
}

<div class="container-fluid py-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <div class="app-page-title"><i class="bi bi-receipt"></i> @ViewData["Title"] #@Model?.Id</div>
            <div class="text-muted">Thông tin nhà cung cấp và danh sách thuốc nhập</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-action="Orders"><i class="bi bi-arrow-left"></i> Quay lại</a>
        </div>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <div><strong>Nhà cung cấp:</strong> @(string.IsNullOrWhiteSpace(Model?.SupplierName) ? $"NCC #{Model?.SupplierId}" : Model.SupplierName)</div>
                    <div class="text-muted small">ID: @Model?.SupplierId</div>
                    <div class="mt-2"><strong>Ngày tạo:</strong> @Model?.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="mt-2"><strong>Tổng tiền:</strong> <span class="text-success">@(totalAmount.ToString("N0")) ₫</span></div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header"><strong>Chi tiết</strong></div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Thuốc</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if ((Model?.Details?.Count ?? 0) == 0)
                                {
                                    <tr><td colspan="5" class="text-center text-muted py-3">Không có chi tiết</td></tr>
                                }
                                else
                                {
                                    foreach (var d in Model?.Details ?? new List<PharmaWebApp.Models.PurchaseOrderDetailViewModel>())
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(d.DrugName) ? $"#{d.DrugId}" : d.DrugName)</div>
                                                <div class="text-muted small">ID: @d.DrugId</div>
                                            </td>
                                            <td class="text-center"><strong>@d.Quantity</strong></td>
                                            <td class="text-end">@(d.UnitPrice.ToString("N0")) ₫</td>
                                            <td class="text-end"><strong>@((d.UnitPrice * d.Quantity).ToString("N0")) ₫</strong></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="text-end"><strong>TỔNG CỘNG:</strong></td>
                                    <td class="text-end"><strong class="text-success">@(totalAmount.ToString("N0")) ₫</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
