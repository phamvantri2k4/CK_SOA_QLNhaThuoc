@model List<PharmaWebApp.Models.SupplierViewModel>
@{
    ViewData["Title"] = "Nhà cung cấp";
}

<div class="container-fluid py-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <div class="app-page-title"><i class="bi bi-building"></i> @ViewData["Title"]</div>
            <div class="text-muted">Quản lý danh sách nhà cung cấp</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" asp-action="Orders"><i class="bi bi-receipt"></i> Đơn nhập</a>
            <a class="btn btn-success" asp-action="Create"><i class="bi bi-plus-circle"></i> Thêm NCC</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Tên nhà cung cấp</th>
                            <th>Điện thoại</th>
                            <th>Địa chỉ</th>
                            <th class="text-end" style="width: 220px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || Model.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Chưa có nhà cung cấp</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var s in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@s.Name</div>
                                        <div class="text-muted small">ID: @s.Id</div>
                                    </td>
                                    <td>@s.Phone</td>
                                    <td>@s.Address</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.Id"><i class="bi bi-pencil"></i> Sửa</a>
                                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@s.Id"><i class="bi bi-trash"></i> Xóa</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
