@model PharmaWebApp.Models.CreateSupplierViewModel
@{
    ViewData["Title"] = "Thêm nhà cung cấp";
}

<div class="container-fluid py-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <div class="app-page-title"><i class="bi bi-plus-circle"></i> @ViewData["Title"]</div>
            <div class="text-muted">Tạo mới nhà cung cấp</div>
        </div>
        <div>
            <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Quay lại</a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Tên nhà cung cấp</label>
                            <input asp-for="Name" class="form-control" placeholder="VD: Công ty Dược ABC" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">Điện thoại</label>
                            <input asp-for="Phone" class="form-control" placeholder="VD: 0909xxxxxx" required />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">Địa chỉ</label>
                            <input asp-for="Address" class="form-control" placeholder="VD: 123 Nguyễn Trãi, Q1" required />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
                            <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Lưu</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
