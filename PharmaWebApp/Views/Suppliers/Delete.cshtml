@model PharmaWebApp.Models.SupplierViewModel
@{
    ViewData["Title"] = "Xóa nhà cung cấp";
}

<div class="container-fluid py-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <div class="app-page-title text-danger"><i class="bi bi-trash"></i> @ViewData["Title"]</div>
            <div class="text-muted">Xác nhận xóa nhà cung cấp</div>
        </div>
        <div>
            <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Quay lại</a>
        </div>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    <div class="row">
        <div class="col-lg-7">
            <div class="card border-danger">
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>Cảnh báo:</strong> Hành động này không thể hoàn tác.
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-4">Tên</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Điện thoại</dt>
                        <dd class="col-sm-8">@Model.Phone</dd>

                        <dt class="col-sm-4">Địa chỉ</dt>
                        <dd class="col-sm-8">@Model.Address</dd>
                    </dl>

                    <form asp-action="Delete" method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="d-flex justify-content-end gap-2">
                            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
