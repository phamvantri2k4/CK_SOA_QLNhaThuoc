@model PharmaWebApp.Models.SalesReportViewModel

<div class="card">
    <div class="card-header"><strong>Danh sách hóa đơn</strong></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Thời gian</th>
                        <th>Khách</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Tổng tiền</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Invoices.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">Chưa có hóa đơn</td></tr>
                    }
                    else
                    {
                        foreach (var inv in Model.Invoices)
                        {
                            <tr>
                                <td><strong>#@inv.Id</strong></td>
                                <td>@inv.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@inv.CustomerName</td>
                                <td>
                                    @if (inv.PaymentStatus == "Paid")
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>
                                <td class="text-end"><strong class="text-success">@inv.TotalAmount.ToString("N0") ₫</strong></td>
                                <td class="text-end">
                                    <a asp-controller="Sales" asp-action="Details" asp-route-id="@inv.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
