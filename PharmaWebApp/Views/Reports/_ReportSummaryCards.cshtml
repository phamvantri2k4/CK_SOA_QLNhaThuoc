@model PharmaWebApp.Models.SalesReportViewModel

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Tổng doanh thu</div>
                <div class="fs-4 fw-bold text-success">@Model.TotalRevenue.ToString("N0") ₫</div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Hóa đơn</div>
                <div class="fs-4 fw-bold">@Model.InvoiceCount</div>
                <div class="text-muted small">Paid: @Model.PaidCount | Pending: @Model.PendingCount</div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Doanh thu đã thanh toán</div>
                <div class="fs-4 fw-bold">@Model.PaidRevenue.ToString("N0") ₫</div>
            </div>
        </div>
    </div>
</div>
