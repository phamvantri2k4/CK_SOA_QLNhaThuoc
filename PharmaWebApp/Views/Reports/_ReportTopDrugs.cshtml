@model PharmaWebApp.Models.SalesReportViewModel

<div class="card">
    <div class="card-header"><strong>Top thuốc (theo doanh thu)</strong></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Thuốc</th>
                        <th class="text-end">SL</th>
                        <th class="text-end">Doanh thu</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TopDrugs.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center text-muted py-3">Chưa có dữ liệu</td></tr>
                    }
                    else
                    {
                        foreach (var d in Model.TopDrugs)
                        {
                            <tr>
                                <td>
                                    <div><strong>@d.DrugName</strong></div>
                                    <div class="text-muted small">ID: @d.DrugId</div>
                                </td>
                                <td class="text-end">@d.Quantity</td>
                                <td class="text-end"><strong class="text-success">@d.Revenue.ToString("N0") ₫</strong></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
