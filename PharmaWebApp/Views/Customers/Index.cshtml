@model PharmaWebApp.Models.PagedList<PharmaWebApp.Models.CustomerViewModel>
@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-people text-success"></i> Quản lý khách hàng
        </h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm khách hàng mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Items.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-success">
                            <tr>
                                <th>ID</th>
                                <th>Tên khách hàng</th>
                                <th>Số điện thoại</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model.Items)
                            {
                                <tr>
                                    <td>@customer.Id</td>
                                    <td>
                                        <strong>@customer.Name</strong>
                                    </td>
                                    <td>
                                        <i class="bi bi-telephone"></i> @customer.Phone
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-info" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-warning" title="Sửa">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@customer.Id" class="btn btn-sm btn-danger" title="Xóa">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* Phân trang *@
        @await Html.PartialAsync("_Pagination", Model)
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-inbox" style="font-size: 48px;"></i>
            <p class="mt-3 mb-0">Chưa có khách hàng nào trong hệ thống.</p>
            <a asp-action="Create" class="btn btn-success mt-3">
                <i class="bi bi-plus-circle"></i> Thêm khách hàng đầu tiên
            </a>
        </div>
    }
</div>

