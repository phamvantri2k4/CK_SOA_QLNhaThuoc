@model PharmaWebApp.Models.CustomerViewModel
@{
    ViewData["Title"] = "Chi tiết khách hàng";
    var purchaseHistory = ViewBag.PurchaseHistory as List<PharmaWebApp.Models.SaleInvoiceDisplayViewModel> ?? new List<PharmaWebApp.Models.SaleInvoiceDisplayViewModel>();
}

<div class="container py-4">
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-person-circle"></i> Thông tin khách hàng
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">ID:</dt>
                        <dd class="col-sm-8"><strong>@Model.Id</strong></dd>

                        <dt class="col-sm-4">Tên khách hàng:</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Số điện thoại:</dt>
                        <dd class="col-sm-8">
                            <i class="bi bi-telephone"></i> @Model.Phone
                        </dd>
                    </dl>

                    <div class="mt-3">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil"></i> Sửa thông tin
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xóa
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-cart-check"></i> Lịch sử mua hàng
                        <span class="badge bg-light text-dark ms-2">@purchaseHistory.Count đơn</span>
                    </h5>
                </div>
                <div class="card-body">
                    @if (purchaseHistory.Any())
                    {
                        <div class="list-group">
                            @foreach (var sale in purchaseHistory)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1">
                                                <a asp-controller="Sales" asp-action="Details" asp-route-id="@sale.Id" class="text-decoration-none">
                                                    Hóa đơn #@sale.Id
                                                </a>
                                            </h6>
                                            <small class="text-muted">
                                                <i class="bi bi-calendar"></i> @sale.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                            </small>
                                            <br>
                                            <small class="text-muted">
                                                <i class="bi bi-box"></i> @sale.Items.Count sản phẩm
                                            </small>
                                        </div>
                                        <div class="text-end">
                                            <strong class="text-success">@sale.TotalAmount.ToString("N0") đ</strong>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">
                            <i class="bi bi-inbox"></i><br>
                            Khách hàng chưa có đơn hàng nào
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

